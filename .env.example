# Claude API key from https://console.anthropic.com. Without it the app runs in demo mode with sample output.
ANTHROPIC_API_KEY=

# Model for analysis and scripts. Opus 5.5 by default.
FRONTMAN_MODEL=claude-opus-5-5

# Supabase. Leave all three blank for local development: no login, data in .data/db.json, takes in .data/takes/.
SUPABASE_URL=
# Publishable key (sb_publishable_...). Turns on login.
SUPABASE_PUBLISHABLE_KEY=
# Secret service_role key. Server only; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Accounts. Comma-separated emails of Frontman team members who can see every workspace.
FRONTMAN_OPERATOR_EMAILS=
# If set, signing up needs this code. Set it before sharing the URL.
FRONTMAN_INVITE_CODE=
# Optional: the public URL for email links and QR codes (defaults to the request's host).
FRONTMAN_PUBLIC_URL=
# Optional: per-take upload cap in MB (Supabase free plan allows 50).
FRONTMAN_MAX_UPLOAD_MB=50

# Optional: a Meta app access token, so reference videos from Instagram get their caption via oEmbed.
# Without it, Instagram references rely on the owner's note.
META_OEMBED_TOKEN=

# Only for the local stdio MCP server (npm run mcp): a key from the API keys page.
FRONTMAN_API_KEY=

# Delivery coach and Edit: transcription with word timings and filler words (deepgram.com).
DEEPGRAM_API_KEY=
# Optional per-agent model overrides (defaults: Opus 5.5 for writing and judging, Haiku 5.5 for frame checks).
# FRONTMAN_MODEL_STORY= FRONTMAN_MODEL_BRAND= FRONTMAN_MODEL_COACH= FRONTMAN_MODEL_FRAMES= FRONTMAN_MODEL_EDIT= FRONTMAN_MODEL_CAPTIONS=

# Edit: renders finished 9:16 videos from Claude's edit plan (creatomate.com).
CREATOMATE_API_KEY=

# Post and Insights. Encrypts platform tokens and signs sign-in links (any long random string).
FRONTMAN_TOKEN_KEY=
# The scheduler calls /api/cron/publish with this as a bearer token.
CRON_SECRET=
# Developer apps (redirect URL: https://YOUR_HOST/api/connect/<ig|tt|yt|li>/callback)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# After TikTok audits the app: PUBLIC_TO_EVERYONE (until then posts are private).
TIKTOK_PRIVACY=SELF_ONLY
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn API version header (YYYYMM, must be an active version).
LINKEDIN_API_VERSION=202609
